; Prism — Water Sort. Open this project with Godot 4.6 or later.
config_version=5

[application]
config/name="Prism — Water Sort"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/version="1.0.0"

[display]
window/size/viewport_width=480
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=360
window/size/min_height=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.071, 0.043, 0.18, 1)

[audio]
default_bus_layout=""

[input_devices]
pointing/emulate_mouse_from_touch=true
